# Public environment variables (copy to .env.local for local development)

# Canonical site URL used for metadata, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://global.buybringsolutions.com

# Experimental light/dark theme switcher (Phase 1 — testing only)
# Set to "true" to enable the theme toggle in the header.
# When unset or "false", the site uses the default dark theme only.
NEXT_PUBLIC_ENABLE_THEME_SWITCHER=true

# Contact form → bot_lead Telegram automation
# URL of the bot_lead endpoint that receives website form submissions.
# Example: https://your-bot-lead.railway.app/webhook/website-form
CONTACT_WEBHOOK_URL=
# Shared secret — must match WEBSITE_LEAD_WEBHOOK_SECRET in bot_lead (.env).
CONTACT_WEBHOOK_SECRET=

# Notion integration (server-side only; never prefix these with NEXT_PUBLIC_)
# NOTION_API_TOKEN is preferred. NOTION_API_KEY remains supported as a legacy alias.
NOTION_API_TOKEN=
NOTION_API_KEY=
NOTION_PROJECTS_DATABASE_ID=
NOTION_BLOG_DATA_SOURCE_ID=8c0d09be-98d8-48ce-85be-4f2fff313766
